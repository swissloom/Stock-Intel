# Stock-Intel environment template
# Copy to `.env` and adjust. No real secrets belong in this file.

# Logging verbosity for the pipeline (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Set to 0 (or false/no/off) to disable the simulated execution-latency
# time.sleep. Recommended in CI and when running the test-suite so pytest runs
# fast. Leave unset (or 1) for realistic latency simulation in live runs.
SIMULATE_LATENCY=1

# Optional market-data provider API keys. yfinance (the default source) needs
# no key; these are placeholders for alternative providers.
# ALPHAVANTAGE_API_KEY=
# FINNHUB_API_KEY=
